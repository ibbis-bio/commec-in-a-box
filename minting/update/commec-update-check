#!/usr/bin/env bash
# Check both update axes - the commec package (conda) and the screening databases (R2) - and
# publish the result for the rest of the update system.
#
# Writes two files into $XDG_RUNTIME_DIR:
#   commec-update.json    full state: versions, per-database revisions, sizes  (the dialog)
#   commec-update.status  ONE token, cheap to read                            (the conky line)
#
# Tokens: "offline" | "up-to-date" | "available:sw=<ver>" | "available:db=<n>"
#         | "available:sw=<ver>,db=<n>" | "blocked:<n>"  (n databases are behind but need a
#         newer commec than is installed, and no commec update is on offer yet)
#
# Runs as the desktop user - read-only, no privilege. Driven by the poller, the desktop icon,
# and the NetworkManager dispatcher.
set -uo pipefail

# conda's solver spawns via multiprocessing, which chdir()s to the current directory; if the
# caller's cwd is unreadable by this user (e.g. /root, when triggered from a root NM dispatcher),
# that spawn fails and the whole search errors out -> a false "offline". Anchor to a safe cwd.
cd "${HOME:-/}" || cd /

# Paths are overridable ONLY so this can be rehearsed off-appliance; the appliance always uses
# the defaults.
CONDA="${COMMEC_CONDA:-/opt/miniconda/bin/conda}"
PY="${COMMEC_BASE_PYTHON:-/opt/miniconda/bin/python}"
ENVLINK="${COMMEC_ENV_LINK:-/opt/commec/current-env}"
CONF="${COMMEC_BOX_CONF:-/etc/commec-box/update.conf}"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATUS="$RUNTIME/commec-update.status"
STATE="$RUNTIME/commec-update.json"
# Diagnostics for the check itself. A silently-failing check is the single most confusing
# failure mode of this system (it surfaces only as a wrong conky label), so keep the stderr.
CHECKLOG="$RUNTIME/commec-update-check.log"
DB_STATUS_HELPER="${COMMEC_DB_STATUS:-/usr/local/lib/commec-box/commec-db-status.py}"

# Defaults (overridable in update.conf)
conda_channels="conda-forge,bioconda"
probe_url="https://conda.anaconda.org"
db_dir=/home/commec-user/commec-dbs
db_channel=latest
db_update_enabled=1
[ -r "$CONF" ] && . "$CONF"

# Publish both files together so a reader never sees a token that disagrees with the state.
publish() {  # <token> <json>
  printf '%s\n' "$2" > "$STATE"
  printf '%s\n' "$1" > "$STATUS"
  printf '%s\n' "$1"
}

offline_json() {
  "$PY" -c 'import json,sys; print(json.dumps({"online": False, "commec": {}, "databases": {}}))'
}

# -c args from the comma list
chan_args=""; oldifs=$IFS; IFS=','
for c in $conda_channels; do [ -n "$c" ] && chan_args="$chan_args -c $c"; done
IFS=$oldifs

# Installed version (via the current-env symlink)
installed=$("$CONDA" list -p "$ENVLINK" '^commec$' --json 2>>"$CHECKLOG" | "$PY" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: d=[]
print(d[0]["version"] if d else "")')
# An unknown installed version must NOT default to "0": every published build would then look
# newer and the operator would be prompted to "update" onto whatever the channel offers.
if [ -z "$installed" ]; then
  echo "cannot determine installed commec version in $ENVLINK" >>"$CHECKLOG"
  publish offline "$(offline_json)"; exit 0
fi

# Reachability probe so "offline" is distinguishable from "up-to-date"
if ! curl -fsS --max-time 8 -o /dev/null "$probe_url"; then
  publish offline "$(offline_json)"; exit 0
fi

# Newest available across the channels (conda version ordering)
latest=$(timeout 120 "$CONDA" search $chan_args '^commec$' --json 2>>"$CHECKLOG" | "$PY" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
vs=[p.get("version") for p in d.get("commec",[]) if p.get("version")]
if not vs: sys.exit(1)
try:    from conda.models.version import VersionOrder as V
except Exception: from packaging.version import parse as V
print(str(max(vs, key=V)))')

# Connected but the search failed -> be conservative, treat as offline (do not nag/false-prompt)
[ -z "$latest" ] && { publish offline "$(offline_json)"; exit 0; }

sw_newer=$("$PY" -c '
import sys
a,b=sys.argv[1],sys.argv[2]
try:    from conda.models.version import VersionOrder as V
except Exception: from packaging.version import parse as V
print("yes" if V(b) > V(a) else "no")' "$installed" "$latest")

# --- databases ------------------------------------------------------------------------------
# Run the helper with the CURRENT ENV's python: the supported-revision ceiling lives in the
# installed commec package, so this answer must come from the commec that is actually in use.
db_json=""
if [ "$db_update_enabled" = "1" ] && [ -x "$ENVLINK/bin/python" ] && [ -r "$DB_STATUS_HELPER" ]; then
  db_args=(--db-dir "$db_dir" --channel "$db_channel")
  db_json=$("$ENVLINK/bin/python" "$DB_STATUS_HELPER" "${db_args[@]}" 2>>"$CHECKLOG")
fi

state=$("$PY" - "$installed" "$latest" "$sw_newer" "$db_json" <<'PY'
import json, sys

installed, latest, sw_newer, db_raw = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    db = json.loads(db_raw) if db_raw else {}
except ValueError:
    db = {}

state = {
    "online": True,
    "commec": {"installed": installed, "latest": latest, "update": sw_newer == "yes"},
    "databases": db.get("databases", {}),
    "db_ok": bool(db.get("ok")),
    "db_error": db.get("error"),
    "db_update_count": db.get("update_count", 0),
    "db_download_bytes": db.get("download_bytes", 0),
    "db_required_bytes": db.get("required_bytes", 0),
    "blocked_by_commec_version": bool(db.get("blocked_by_commec_version")),
}

parts = []
if state["commec"]["update"]:
    parts.append(f"sw={latest}")
if state["db_update_count"]:
    parts.append(f"db={state['db_update_count']}")

if parts:
    state["token"] = "available:" + ",".join(parts)
elif state["blocked_by_commec_version"]:
    # Nothing is installable right now, but the box is NOT up to date: a newer database exists
    # and this commec is too old to accept it. Reporting "up-to-date" here would show a green
    # overlay on a box that is knowingly behind, which is the one thing the status must not do.
    blocked = sum(1 for v in state["databases"].values() if v.get("status") == "blocked")
    state["token"] = f"blocked:{blocked}"
else:
    state["token"] = "up-to-date"

print(json.dumps(state))
PY
)

[ -n "$state" ] || { publish offline "$(offline_json)"; exit 0; }
token=$(printf '%s' "$state" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["token"])')
publish "$token" "$state"
