#!/usr/bin/env bash
# Patch the commec screen-default-config.yaml INSIDE a given env for this appliance:
#   commec-patch-config <env-path> [db-dir]
# Sets base_paths.default to the absolute DB dir and forces blast_mt_mode=0. Uses the TARGET env's
# own python/importlib so it edits that env's package copy (never the base env). Idempotent -
# writes fixed values, so re-running is a no-op-equivalent.
#
# Called at mint (30-commec-setup.sh) AND by commec-update-apply after each A/B `conda create`, so
# every env - original and updated - carries the same DB dir + threading. Without this, an updated
# env ships commec's pristine config (base_paths.default=null, mt_mode=1) and screening breaks
# after the flip.
#
# No DB-path re-pointing is needed: the appliance lays the DBs out under base_paths.default in the
# canonical commec 1.1.0 layout (biorisk/, low_concern/, control_lists/, best_match/{protein/prot,
# nucleotide/nucl}), which the shipped screen-default-config.yaml paths ({default}<name>/...)
# already point at. So base_paths.default is the only DB knob to set here.
set -euo pipefail

ENVP="${1:?usage: commec-patch-config <env-path> [db-dir]}"
DBDIR="${2:-/home/commec-user/commec-dbs}"
PY="$ENVP/bin/python"
[ -x "$PY" ] || { echo "commec-patch-config: no python in env: $ENVP" >&2; exit 1; }

"$PY" - "$DBDIR" <<'PY'
import sys, pathlib, importlib.resources, yaml
dbdir = sys.argv[1].rstrip("/") + "/"
p = pathlib.Path(str(importlib.resources.files("commec").joinpath("screen-default-config.yaml")))
cfg = yaml.safe_load(p.read_text())
# Absolute DB dir, trailing slash (paths are "{default}best_match/..." etc.).
cfg.setdefault("base_paths", {})["default"] = dbdir
# BLAST threading for this appliance: mt_mode=0 (auto) beats the shipped default of 1
# (split-by-database) on a single fast local SSD. Set at the CONFIG level so EVERY run - CLI
# `commec screen` or GUI - uses it, not just the GUI presets. Upstream default stays 1.
cfg["blast_mt_mode"] = 0
p.write_text(yaml.safe_dump(cfg, sort_keys=False))
print("commec-patch-config: patched", p, "-> base_paths.default", dbdir, "+ blast_mt_mode=0")
PY
