#!/usr/bin/env bash
# One-time root helper: set commec-user's password from stdin (account password + a werkzeug
# hash for the commec-gui LAN auth), then revoke its own privilege. Invoked by the first-run GUI
# via a single-command NOPASSWD sudoers entry
# (the only way to set the very first password, since sudo would otherwise need the
# password we are about to create). Reads the password from stdin so it never appears
# in the process list.
set -euo pipefail

GUARD=/var/lib/commec/password.done
if [ -e "$GUARD" ]; then
  echo "password already set"
  exit 0
fi

IFS= read -r newpass || true
if [ -z "${newpass:-}" ]; then
  echo "empty password" >&2
  exit 1
fi

echo "commec-user:$newpass" | chpasswd
chage -M -1 -E -1 commec-user            # no expiry / aging

# Also write a werkzeug hash of the same password for the commec-gui LAN auth (the GUI can't read
# the account password back out of shadow, so capture it here). Best-effort: a clean no-op on
# non-kiosk images that don't have werkzeug in the env.
GUIHASH=/home/commec-user/.config/commec-gui/password.hash
PYBIN=/opt/commec/current-env/bin/python
if [ -x "$PYBIN" ]; then
  install -d -o commec-user -g commec-user -m 700 "$(dirname "$GUIHASH")"
  if printf '%s' "$newpass" | "$PYBIN" -c \
      'import sys; from werkzeug.security import generate_password_hash as h; print(h(sys.stdin.read()))' \
      > "$GUIHASH" 2>/dev/null; then
    chown commec-user:commec-user "$GUIHASH"; chmod 600 "$GUIHASH"
  else
    rm -f "$GUIHASH"   # werkzeug not present (non-kiosk image) - leave no partial file
  fi
fi

mkdir -p "$(dirname "$GUARD")"
touch "$GUARD"

# Revoke the one-time privilege; from now on sudo needs the password just set.
rm -f /etc/sudoers.d/zzz-commec-firstrun
echo "ok"
